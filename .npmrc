# Match Aikido safe-chain's default minimum package age (48h) so npm never
# resolves a version that CI's `npm ci` would then reject as too fresh. Keep
# in sync with the `cooldown` in .github/dependabot.yml. @thing-it packages
# are our own registry releases, consumed right after publish, so they're
# exempt.
min-release-age=2
min-release-age-exclude[]=@thing-it/*
